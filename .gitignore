# Build output — reproducible from zb_smart_gizmo/, not source of truth
Release/*.rbz
Release/*_RBZ*/
archive/legacy_release/*.rbz

# Working snapshots — not source of truth, kept locally only.
# (Trailing /* rather than / so the !negation below can still track the manifest.)
backups/*
!backups/README.md

# Unused third-party license/signature file (see AUDIT_REPORT.md H1) —
# excluded regardless of removal status so it can never re-enter history
EW.lic

# SketchUp Extension Warehouse license records (EW.lic and any test license)
# live in SketchUp's own ProgramData folder -- never inside this repository,
# a package input, or a backup. Excluded by extension so no record or
# signature can ever be committed or shipped.
*.lic

# Local DEV / live-test packages -- never committed as production artifacts
Test Builds/

# OS / editor cruft
.DS_Store
Thumbs.db
